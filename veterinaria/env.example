# Copiar este archivo como .env y completar con los datos de tu base local.
# Formato: postgresql+asyncpg://USUARIO:CLAVE@HOST:PUERTO/BASE
DATABASE_URL=postgresql+asyncpg://usuario:clave@localhost:5432/veterinaria

# Opcional: poner true para ver en la consola las consultas SQL (echo=True).
ECHO_SQL=false
